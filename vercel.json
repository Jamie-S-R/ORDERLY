{
  "version": 2,
  "framework": "create-react-app",
  "functions": {
    "api/supabase.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/supabase.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}