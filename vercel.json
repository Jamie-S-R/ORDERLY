{
  "version": 2,
  "framework": "create-react-app",
  "functions": {
    "api/supabase.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/supabase",
      "dest": "/api/supabase.js",
      "methods": ["GET", "POST", "DELETE"]
    },
    {
      "src": "/(manifest.json|favicon.ico|.*\\.(png|jpg|jpeg|gif|svg|ico|css|js|json|woff|woff2|ttf|eot))",
      "dest": "/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}