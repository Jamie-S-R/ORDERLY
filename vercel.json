{
  "version": 2,
  "framework": "create-react-app",
  "functions": {
    "api/supabase.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/supabase",
      "dest": "/api/supabase.js",
      "methods": ["GET", "POST", "DELETE"]
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}